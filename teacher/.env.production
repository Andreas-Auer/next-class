# Production build values (committed). Loaded by prebuild.js when .env is absent (CI).
# Local development overrides go into .env (gitignored, see .env-example).

# Version & build
VERSION=0.1.0
BUILD_NUMBER=1
PRODUCT_NAME="Next-Class-Teacher"
INFO="Release"

# App / network (must match between teacher and student)
CLIENT_DIRECTORY="NEXT-CLASS-TEACHER"
SERVER_API_PORT=22522
MULTICAST_CLIENT_PORT=6124
MULTICAST_ADDRESS=239.255.42.1
MULTICAST_SERVER_CLIENT_PORT=6125

# Build options
SIGN=false
NOTARIZE=false
SHOWDEVTOOLS=false
DEVELOPMENT=false

# App secrets (placeholder "NEXT-CLASS"; CI may overwrite before build). Must be identical in teacher and student.
API_SECRET=NEXT-CLASS
CONNECTION_SECRET=NEXT-CLASS
